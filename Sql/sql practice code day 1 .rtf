-- ==========================================\
-- SQL BASIC PRACTICE\
-- Database: Northwind\
-- Topics: SELECT, DISTINCT, WHERE, ORDER BY,\
-- LIMIT, OFFSET, COUNT, MIN, AVG, SUM\
-- ==========================================\
\
\
-- ==========================================\
-- 1. CUSTOMERS TABLE\
-- ==========================================\
\
-- Display all customers\
SELECT * FROM customers;\
\
-- Display unique countries\
SELECT DISTINCT country FROM customers;\
\
-- Count unique countries\
SELECT COUNT(DISTINCT country) FROM customers;\
\
-- Find customers from London\
SELECT *\
FROM customers\
WHERE city = 'London';\
\
-- Sort customers by postal code\
SELECT *\
FROM customers\
ORDER BY postal_code;\
\
-- Display first 20 customers\
SELECT *\
FROM customers\
LIMIT 20;\
\
-- Pagination: Skip 40 records and display 20\
SELECT *\
FROM customers\
LIMIT 20 OFFSET 40;\
\
\
-- ==========================================\
-- 2. PRODUCTS TABLE\
-- ==========================================\
\
-- Display all products\
SELECT * FROM products;\
\
-- Display unique product names\
SELECT DISTINCT product_name FROM products;\
\
-- Find products in category 2\
SELECT *\
FROM products\
WHERE category_id = 2;\
\
-- Sort products by price\
SELECT *\
FROM products\
ORDER BY price;\
\
-- Display first 10 products\
SELECT *\
FROM products\
LIMIT 10;\
\
-- Pagination: Skip 20 records and display 30\
SELECT *\
FROM products\
LIMIT 30 OFFSET 20;\
\
-- Find minimum product price\
SELECT MIN(price)\
FROM products;\
\
-- Calculate average product price\
SELECT AVG(price)\
FROM products;\
\
\
-- ==========================================\
-- 3. ORDERS TABLE\
-- ==========================================\
\
-- Display all orders\
SELECT * FROM orders;\
\
-- Find orders for customer ID 61\
SELECT *\
FROM orders\
WHERE customer_id = 61;\
\
-- Display unique customer IDs\
SELECT DISTINCT customer_id\
FROM orders;\
\
-- Display first 10 orders\
SELECT *\
FROM orders\
LIMIT 10;\
\
-- Sort orders by order date\
SELECT *\
FROM orders\
ORDER BY order_date;\
\
\
-- ==========================================\
-- 4. ORDER_DETAILS TABLE\
-- ==========================================\
\
-- Display all order details\
SELECT * FROM order_details;\
\
-- Calculate total quantity\
SELECT SUM(quantity)\
FROM order_details;\
\
-- Find minimum quantity\
SELECT MIN(quantity)\
FROM order_details;\
\
-- Calculate average quantity\
SELECT AVG(quantity)\
FROM order_details;\
\
\
-- ==========================================\
-- END OF SQL BASIC PRACTICE\
